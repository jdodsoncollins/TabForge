// Public defaults work for unsigned Simulator builds. Use your own identifiers
// and signing team for physical devices; keep those overrides out of Git.
TABFORGE_BUNDLE_IDENTIFIER = org.example.TabForge

// The App Group the companion app writes keyboard settings to. The keyboard
// only reads it, which iOS allows without Full Access. Register this group
// for your own team when you change the bundle identifier.
TABFORGE_APP_GROUP = group.$(TABFORGE_BUNDLE_IDENTIFIER)

// Generated by Scripts/configure-build.py from your ignored .env file.
#include? "Signing.local.xcconfig"
